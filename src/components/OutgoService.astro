---
import Layout from '~/layouts/OutgoLayout.astro';
import { services, inquiryLink } from '~/data/services';
interface Props {
  slug: string;
}
const service = services.find((item) => item.slug === Astro.props.slug)!;
---

<Layout title={`${service.name} — OUTGOPRO`} description={service.description}>
  <section class="service-hero container">
    <a class="back-link" href="/#services">← 全部服务</a>
    <div class="service-hero-grid">
      <div>
        <p class="eyebrow"><span class="orange-dot"></span> {service.english} / {service.number}</p><h1>
          {service.headline[0]}<br /><span class="accent">{service.headline[1]}</span>
        </h1><p class="lead">{service.description}</p><a class="button" href={inquiryLink(service.name)}
          >聊聊{service.name} <span aria-hidden="true">↗</span></a
        >
      </div><aside class="scope-panel">
        <span class="eyebrow">THE SCOPE</span><h2>服务，从这些开始。</h2><ul>
          {
            service.scope.map((item, index) => (
              <li>
                <span>0{index + 1}</span>
                {item}
              </li>
            ))
          }
        </ul><p>{service.audience}</p>
      </aside>
    </div>
  </section>
  <section class="service-story container" aria-label="服务介绍">
    {
      service.blocks.map(([title, text], index) => (
        <article data-reveal>
          <>
            <span class="eyebrow">0{index + 1} /</span>
            <h2>{title}</h2>
            <p>{text}</p>
          </>
        </article>
      ))
    }
  </section>
  <section class="prepare-section">
    <div class="container prepare-grid">
      <div><p class="eyebrow">BEFORE WE START</p><h2>带着这些，<br />聊得更具体。</h2></div><div>
        <p>不必准备一份完美的需求书。先把现状告诉我们。</p><ul>
          {
            service.prepare.map((item) => (
              <li>
                <span aria-hidden="true">↗</span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  {
    service.slug === 'websites' && (
      <section class="container small-work">
        <>
          <p class="eyebrow">A LITTLE INSPIRATION</p>
          <h2>先找到你喜欢的感觉。</h2>
          <p>从设计示例开始，聊聊适合你业务的视觉方向。</p>
          <a class="text-link" href="https://gscase.outgopro.com" target="_blank" rel="noopener noreferrer">
            浏览完整案例库 ↗
          </a>
        </>
      </section>
    )
  }
  <section class="faq-section container">
    <div><p class="eyebrow">GOOD QUESTIONS</p><h2>你可能还想知道。</h2></div><div class="faq-list">
      {
        service.faq.map(([question, answer]) => (
          <details>
            <>
              <summary>
                {question}
                <span aria-hidden="true">＋</span>
              </summary>
              <p>{answer}</p>
            </>
          </details>
        ))
      }
    </div>
  </section>
</Layout>
