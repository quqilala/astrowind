---
import Layout from '~/layouts/OutgoLayout.astro';
import { email, services } from '~/data/services';
---

<Layout
  title="关于我们 — 让你的下一步，更清楚。"
  description="OUTGOPRO 提供网站建设、公司注册与报税、商标注册、VPN 与企业网络、AI 聚合 API 服务。从你的实际业务出发，明确方案与交付。"
>
  <section class="about-hero container">
    <p class="eyebrow"><span class="orange-dot"></span> ABOUT OUTGOPRO</p><h1>
      你专注生意。<br /><span class="accent">我们理顺复杂。</span>
    </h1><p class="lead">
      一个网站，一家公司，一个品牌。<br />每一次开始，都有许多具体的事要做。<br />我们把它们变得更有条理。
    </p>
  </section>
  <section class="about-values container">
    <div><p class="eyebrow">OUR APPROACH</p><h2>说清楚。<br />做扎实。</h2></div><div>
      {
        [
          ['从真实需求出发', '先了解你当前的业务和下一步计划，再讨论需要哪些服务，以及如何推进。'],
          ['让范围看得见', '服务内容、费用、交付和协作方式，在开始前讲清楚。让双方都知道要完成什么。'],
          ['让合作有连续性', '把资料和过程整理好，完成交接。需要持续协作的部分，按实际需求安排。'],
        ].map(([title, text]) => (
          <article>
            <>
              <h3>{title}</h3>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section id="contact" class="contact-page">
    <div class="container contact-page-grid">
      <div>
        <p class="eyebrow">LET’S TALK</p><h2>你的计划，<br />我们愿意听。</h2><p>
          选择想了解的服务，发送一封邮件。<br />不必措辞完美，把事情说清楚就好。
        </p><a class="email-large" href={`mailto:${email}`}>{email} ↗</a>
      </div><form id="inquiry-form">
        <label for="service">你想了解什么？</label><select id="service" name="service"
          >{services.map((service) => <option>{service.name}</option>)}<option>多项服务 / 还没想好</option></select
        ><label for="message">简单说说你的计划</label><textarea
          id="message"
          name="message"
          rows="4"
          maxlength="2000"
          placeholder="例如：想做一个面向海外客户的企业官网，目前已有品牌资料……"
          required></textarea><label for="contact-detail">方便联系的方式（选填）</label><input
          id="contact-detail"
          name="contact"
          maxlength="200"
          placeholder="邮箱、电话或微信"
        /><button type="submit" class="button">用邮件发送咨询 <span aria-hidden="true">↗</span></button><p
          class="form-note"
        >
          将打开你的邮件应用，由你确认发送。网页不会提交或保存表单内容。
        </p><p id="form-status" role="status"></p><button id="copy-inquiry" type="button" class="text-link"
          >没有邮件应用？复制咨询内容</button
        >
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    function inquiry() {
      const data = new FormData(form!);
      return {
        subject: `OUTGOPRO · ${data.get('service')}`,
        body: `你好，OUTGOPRO：\n\n咨询服务：${data.get('service')}\n\n我的计划：\n${data.get('message')}\n\n联系方式：${data.get('contact') || '请回复本邮件'}`,
      };
    }
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const { subject, body } = inquiry();
      window.location.href = `mailto:admin@outgopro.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = '请在邮件应用中确认发送；若未打开，可复制内容后手动发至 admin@outgopro.com。';
    });
    document.querySelector('#copy-inquiry')?.addEventListener('click', async () => {
      const { subject, body } = inquiry();
      try {
        await navigator.clipboard.writeText(`收件人：admin@outgopro.com\n主题：${subject}\n\n${body}`);
        if (status) status.textContent = '已复制。请粘贴到邮件，发送至 admin@outgopro.com。';
      } catch {
        if (status) status.textContent = '浏览器暂不支持自动复制。请手动复制输入内容，发送至 admin@outgopro.com。';
      }
    });
  </script>
</Layout>
