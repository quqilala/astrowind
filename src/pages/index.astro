---
import Layout from '~/layouts/OutgoLayout.astro';
import { services } from '~/data/services';
const works = [
  { slug: 'hkvd', name: '企业形象', type: 'CORPORATE', description: '专业实力，看得见。' },
  { slug: 'wisenvoy', name: '品牌与产品', type: 'BRAND & COMMERCE', description: '让产品，也让品牌被记住。' },
  { slug: 'scenic-travel', name: '生活方式', type: 'LIFESTYLE', description: '用体验，传递吸引力。' },
];
---

<Layout title="OUTGOPRO — 好生意，从这里开始。">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="orange-dot"></span> IDEAS INTO BUSINESS</p><h1>
        好生意，<br />从这里<span class="accent">开始。</span>
      </h1><p class="hero-intro">
        建好网站，成立公司，打理财税。<br />保护品牌，连接团队，接入 AI。<br /><span>让你的每一步，都更有底气。</span>
      </p><div class="hero-actions">
        <a class="button" href="/about-us#contact">聊聊你的计划 <span aria-hidden="true">↗</span></a><a
          class="text-link"
          href="#services">看看我们能做什么 <span aria-hidden="true">↓</span></a
        >
      </div><p class="hero-note">从国内起步，到海外拓展。按你的节奏来。</p>
    </div>
    <div class="hero-art" aria-label="从品牌网站、公司设立到团队连接的服务示意">
      <div class="art-heading"><span>THE NEXT CHAPTER</span><span>OUTGOPRO / 01</span></div>
      <div class="art-frame">
        <div class="art-grid" aria-hidden="true"></div><span class="art-arrow" aria-hidden="true">↗</span>
        <div class="brand-note">
          <span>一切，从一个想法开始。</span><span class="brand-symbol" aria-hidden="true">®</span>
        </div>
        <div class="browser-object">
          <div class="browser-chrome">
            <span><i></i><i></i><i></i></span><span>YOUR NEXT WEBSITE</span><span>↗</span>
          </div><img
            src="/images/scenic-travel.jpg"
            alt="旅行品牌网站设计示例"
            width="960"
            height="540"
            fetchpriority="high"
          /><div class="browser-caption"><span>好设计，让业务更出众。</span><span>01 / WEBSITE</span></div>
        </div>
        <div class="company-object">
          <div><span class="mini-label">BUSINESS, READY.</span><span aria-hidden="true">↗</span></div><strong
            >把想法，<br />变成下一步。</strong
          ><div class="company-lines" aria-hidden="true"><i></i><i></i></div><span class="company-tag"
            >公司 · 财税 · 品牌</span
          >
        </div>
        <div class="network-object">
          <span class="network-icon" aria-hidden="true">⌁</span><div>
            <strong>连接团队，连接可能。</strong><span>CLOUD & AI AGENT</span>
          </div><i aria-hidden="true"></i>
        </div>
      </div><div class="art-footer"><span>少一些繁琐，多一些专注。</span><span>LET’S GO FURTHER ↗</span></div>
    </div>
  </section>
  <div class="service-strip">
    <div class="container">
      <span>把业务的基础，交给专业的协作。</span><div>
        <span>建站</span><b>／</b><span>公司</span><b>／</b><span>财税</span><b>／</b><span>商标</span><b>／</b><span
          >云部署</span
        ><b>／</b><span>AI Agent</span>
      </div>
    </div>
  </div>
  <section id="services" class="services-section container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">01 / WHAT WE DO</p><h2>事情不必很多。<br /><span class="muted">把重要的做好。</span></h2>
      </div><p>从一个网站，到一家公司的日常。<br />把繁琐的环节理顺，<br />让你专注真正想做的生意。</p>
    </div>
    <div class="service-list">
      {
        services.map((service) => (
          <a href={`/${service.slug}`} class="service-row" data-reveal>
            <>
              <span class="service-number">{service.number}</span>
              <div>
                <>
                  <span class="service-english">{service.english}</span>
                  <h3>{service.name}</h3>
                </>
              </div>
              <p>{service.summary}</p>
              <span class="round-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="statement-section">
    <div class="container statement-inner" data-reveal>
      <p class="eyebrow">BUILT AROUND YOUR BUSINESS</p><h2>
        你的业务，各有不同。<br />我们的起点，<span>始终是你。</span>
      </h2><div>
        <span class="statement-mark" aria-hidden="true">↗</span><p>
          先听你的计划，再讨论怎么实现。<br />把范围、流程和交付讲清楚，<br />让每一次合作，都有看得见的下一步。
        </p>
      </div>
    </div>
  </section>
  <section id="work" class="work-section container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">02 / DESIGN POSSIBILITIES</p><h2>
          好看的背后，<br /><span class="muted">是对业务的理解。</span>
        </h2>
      </div><div>
        <p>不同的生意，值得不同的表达。<br />从设计示例里，找到适合你的方向。</p><a
          class="text-link"
          href="https://gscase.outgopro.com"
          target="_blank"
          rel="noopener noreferrer">探索完整设计案例库 ↗</a
        >
      </div>
    </div><div class="work-grid">
      {
        works.map((work) => (
          <a
            class="work-card"
            href={`https://gscase.outgopro.com/cases/${work.slug}/`}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
          >
            <>
              <div class={`work-image work-${work.slug}`}>
                <>
                  <img
                    src={`/images/${work.slug}.jpg`}
                    alt={`${work.name}网站设计示例`}
                    width="960"
                    height="540"
                    loading="lazy"
                  />
                  <span>查看示例 ↗</span>
                </>
              </div>
              <div class="work-caption">
                <>
                  <div>
                    <>
                      <span class="eyebrow">{work.type}</span>
                      <h3>{work.name}</h3>
                      <p>{work.description}</p>
                    </>
                  </div>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div><p class="work-note">以上为网站设计参考，用于展示风格与交互方向。你的项目，将从你的业务重新出发。</p>
  </section>
  <section id="process" class="process-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">03 / HOW WE WORK</p><h2>复杂的事，<br />清楚地推进。</h2></div><p>
          不用先成为专家。<br />带着问题来，我们一起拆解。
        </p>
      </div><div class="process-grid">
        {
          [
            ['聊聊现状', '你的业务、目前的难点，以及期待的结果。先把目标对齐。'],
            ['确认方案', '明确服务范围、费用、资料与推进安排。知道每一步为什么做。'],
            ['开始推进', '按约定节点开展工作。需要你配合的事项，提前说清楚。'],
            ['完成与交接', '核对成果，交接资料。持续维护的需求，再一起安排。'],
          ].map(([title, text], index) => (
            <article data-reveal>
              <>
                <span>0{index + 1}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="faq-section container">
    <div><p class="eyebrow">A FEW THINGS TO KNOW</p><h2>先回答，<br />你关心的事。</h2></div><div class="faq-list">
      <details>
        <summary>还没有完整方案，可以先聊吗？<span aria-hidden="true">＋</span></summary><p>
          当然。告诉我们你正在做什么、卡在哪一步。沟通的起点可以是一个具体问题，也可以是一个初步想法。
        </p>
      </details><details>
        <summary>能只选择其中一项服务吗？<span aria-hidden="true">＋</span></summary><p>
          可以。各项服务可分别沟通；如果涉及多项需求，再一起协调推进顺序。
        </p>
      </details><details>
        <summary>费用和时间如何确定？<span aria-hidden="true">＋</span></summary><p>
          先了解业务范围、地区、资料情况和交付要求，再确认方案与报价。涉及第三方费用和外部审批的部分会单独说明。
        </p>
      </details><details>
        <summary>通过什么方式联系？<span aria-hidden="true">＋</span></summary><p>
          发送邮件到 <a href="mailto:admin@outgopro.com">admin@outgopro.com</a>，写明你想做的事和方便联系的方式即可。
        </p>
      </details>
    </div>
  </section>
</Layout>
