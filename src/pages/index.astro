---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';

import heroImage from '~/assets/images/hero-image.png';

const metadata = {
  title: 'OUTGOPRO — 出海增长与合规导航',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- ==================== Hero 区 ==================== -->
  <section class="relative overflow-hidden min-h-[80vh] flex items-center hero-gradient">
    <!-- 动态背景 -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="grid-bg"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-20 md:pt-16 md:pb-28 w-full">
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <!-- 左侧文案 -->
        <div class="animate-slide-in-left">
          <div class="inline-flex items-center gap-2 text-xs tracking-widest font-bold uppercase rounded-full px-4 py-2 bg-gradient-to-r from-blue-500/20 to-purple-500/20 text-blue-600 dark:text-blue-300 border border-blue-400/30 dark:border-blue-500/30 mb-6 backdrop-blur-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
            </span>
            OUTGOPRO
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[4rem] font-extrabold tracking-tight leading-[1.1] mb-6" data-i18n="heroTitle">
            <span class="bg-gradient-to-r from-slate-900 via-blue-800 to-purple-800 dark:from-white dark:via-blue-200 dark:to-purple-200 bg-clip-text text-transparent">别卷了，</span>
            <br />
            <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">去赚全世界的钱。</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-500 dark:text-slate-400 mb-10 leading-relaxed max-w-lg" data-i18n="heroDesc">
            AI 提效、海外开公司报税、搭网络、做跨境电商——我们把踩过的坑铺成路，你直接走就好。
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="/ai-tools" class="group relative inline-flex items-center gap-2 px-8 py-4 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold text-lg hover:shadow-lg hover:shadow-blue-500/30 hover:-translate-y-0.5 transition-all duration-300" data-i18n="heroBtn1">
              开始探索
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/about-us" class="inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-slate-300 dark:border-slate-600 font-bold text-lg text-slate-700 dark:text-slate-200 hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 hover:-translate-y-0.5 transition-all duration-300" data-i18n="heroBtn2">
              聊聊合作
            </a>
          </div>
        </div>

        <!-- 右侧配图 -->
        <div class="relative animate-slide-in-right">
          <div class="absolute -inset-6 bg-gradient-to-tr from-blue-500/20 via-purple-500/15 to-pink-500/10 dark:from-blue-500/10 dark:via-purple-500/10 dark:to-pink-500/5 rounded-3xl blur-3xl animate-pulse-slow"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-blue-900/10 dark:shadow-blue-500/5 ring-1 ring-white/20">
            <Image src={heroImage} alt="Outgopro Hero" class="w-full" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 数字统计区 ==================== -->
  <section class="relative -mt-12 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="stat-card">
          <div class="text-3xl md:text-4xl font-black bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">500+</div>
          <div class="text-sm text-slate-500 dark:text-slate-400 mt-1" data-i18n="stat1">工具推荐</div>
        </div>
        <div class="stat-card">
          <div class="text-3xl md:text-4xl font-black bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">20+</div>
          <div class="text-sm text-slate-500 dark:text-slate-400 mt-1" data-i18n="stat2">国家覆盖</div>
        </div>
        <div class="stat-card">
          <div class="text-3xl md:text-4xl font-black bg-gradient-to-r from-pink-600 to-orange-500 bg-clip-text text-transparent">1000+</div>
          <div class="text-sm text-slate-500 dark:text-slate-400 mt-1" data-i18n="stat3">用户信赖</div>
        </div>
        <div class="stat-card">
          <div class="text-3xl md:text-4xl font-black bg-gradient-to-r from-orange-500 to-blue-600 bg-clip-text text-transparent">98%</div>
          <div class="text-sm text-slate-500 dark:text-slate-400 mt-1" data-i18n="stat4">好评率</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 业务板块 ==================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28">
    <!-- 板块标题 -->
    <div class="text-center mb-14 animate-fade-in-up">
      <div class="inline-flex items-center gap-2 text-xs tracking-widest font-bold uppercase rounded-full px-4 py-2 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 mb-4">
        ✨ 核心服务
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4" data-i18n="sectionTitle">我们能帮你做什么？</h2>
      <p class="text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto" data-i18n="sectionDesc">六个核心板块，覆盖出海路上最关键的环节。</p>
    </div>

    <!-- 卡片网格 -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <!-- AI 工具 -->
      <a href="/ai-tools" class="card-glass group animate-fade-in-up" style="animation-delay: 0.1s;">
        <div class="card-icon bg-gradient-to-br from-blue-500 to-cyan-400">🤖</div>
        <h3 class="text-lg font-bold mb-2 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors" data-i18n="aiTitle">AI 工具及工作流</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed" data-i18n="aiDesc">让 AI 替你干活，从内容生产到客户触达，用更少的人做更多的事。</p>
      </a>

      <!-- 海外设立报税 -->
      <a href="/global-tax" class="card-glass group animate-fade-in-up" style="animation-delay: 0.15s;">
        <div class="card-icon bg-gradient-to-br from-emerald-500 to-teal-400">🏦</div>
        <h3 class="text-lg font-bold mb-2 text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors" data-i18n="taxTitle">海外公司 / 账户设立报税</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed" data-i18n="taxDesc">开公司、开户、报税一条龙，别让合规问题在最该冲刺的时候绊倒你。</p>
      </a>

      <!-- 网络技术 -->
      <a href="/network-tech" class="card-glass group animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="card-icon bg-gradient-to-br from-violet-500 to-purple-400">🌐</div>
        <h3 class="text-lg font-bold mb-2 text-slate-900 dark:text-white group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors" data-i18n="netTitle">网络技术</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed" data-i18n="netDesc">稳定的网络是出海的命根子。架构、安全、加速，一个都不能少。</p>
      </a>

      <!-- 跨境电商 -->
      <a href="/cross-border" class="card-glass group animate-fade-in-up" style="animation-delay: 0.25s;">
        <div class="card-icon bg-gradient-to-br from-orange-500 to-amber-400">🛒</div>
        <h3 class="text-lg font-bold mb-2 text-slate-900 dark:text-white group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors" data-i18n="ecomTitle">跨境电商</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed" data-i18n="ecomDesc">选品、流量、履约——帮你找到能持续赚钱的增长路径，不靠玄学。</p>
      </a>

      <!-- Web3 & 区块链 -->
      <a href="/web3" class="card-glass group animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="card-icon bg-gradient-to-br from-indigo-500 to-blue-400">⛓️</div>
        <h3 class="text-lg font-bold mb-2 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors" data-i18n="web3Title">Web3 & 区块链</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed" data-i18n="web3Desc">从 DeFi 到 NFT，从钱包到智能合约——帮你看懂链上世界，找到 Web3 出海的正确姿势。</p>
      </a>

      <!-- 关于我们 -->
      <a href="/about-us" class="card-glass group animate-fade-in-up" style="animation-delay: 0.35s;">
        <div class="card-icon bg-gradient-to-br from-pink-500 to-rose-400">✌️</div>
        <h3 class="text-lg font-bold mb-2 text-slate-900 dark:text-white group-hover:text-pink-600 dark:group-hover:text-pink-400 transition-colors" data-i18n="aboutTitle">关于我们</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed" data-i18n="aboutDesc">一群在技术、财税和商业增长交叉路口蹲了很久的人。方法论靠谱，不画饼。</p>
      </a>
    </div>
  </section>

  <!-- ==================== 底部 CTA ==================== -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 opacity-95"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="cta-orb cta-orb-1"></div>
      <div class="cta-orb cta-orb-2"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-5 animate-fade-in-up" data-i18n="ctaTitle">准备好出海了吗？🌊</h2>
      <p class="text-blue-100 text-lg mb-10 max-w-lg mx-auto animate-fade-in-up" style="animation-delay: 0.1s;" data-i18n="ctaDesc">不管你是刚起步还是已经在路上，我们都可以聊聊。</p>
      <a href="/about-us" class="inline-flex items-center gap-2 px-10 py-4 rounded-full bg-white text-blue-700 font-bold text-lg hover:bg-blue-50 hover:shadow-xl hover:shadow-white/20 hover:-translate-y-1 transition-all duration-300 animate-fade-in-up" style="animation-delay: 0.2s;" data-i18n="ctaBtn">联系我们 →</a>
    </div>
  </section>

  <!-- ==================== 双语切换逻辑 ==================== -->
  <script is:inline>
    const dict = {
      zh: {
        heroTitle: '别卷了，去赚全世界的钱。',
        heroDesc: 'AI 提效、海外开公司报税、搭网络、做跨境电商——我们把踩过的坑铺成路，你直接走就好。',
        heroBtn1: '开始探索',
        heroBtn2: '聊聊合作',
        stat1: '工具推荐',
        stat2: '国家覆盖',
        stat3: '用户信赖',
        stat4: '好评率',
        sectionTitle: '我们能帮你做什么？',
        sectionDesc: '六个核心板块，覆盖出海路上最关键的环节。',
        aiTitle: 'AI 工具及工作流',
        aiDesc: '让 AI 替你干活，从内容生产到客户触达，用更少的人做更多的事。',
        taxTitle: '海外公司 / 账户设立报税',
        taxDesc: '开公司、开户、报税一条龙，别让合规问题在最该冲刺的时候绊倒你。',
        netTitle: '网络技术',
        netDesc: '稳定的网络是出海的命根子。架构、安全、加速，一个都不能少。',
        ecomTitle: '跨境电商',
        ecomDesc: '选品、流量、履约——帮你找到能持续赚钱的增长路径，不靠玄学。',
        web3Title: 'Web3 & 区块链',
        web3Desc: '从 DeFi 到 NFT，从钱包到智能合约——帮你看懂链上世界，找到 Web3 出海的正确姿势。',
        aboutTitle: '关于我们',
        aboutDesc: '一群在技术、财税和商业增长交叉路口蹲了很久的人。方法论靠谱，不画饼。',
        ctaTitle: '准备好出海了吗？🌊',
        ctaDesc: '不管你是刚起步还是已经在路上，我们都可以聊聊。',
        ctaBtn: '联系我们 →',
      },
      en: {
        heroTitle: "Stop grinding. Go make money globally.",
        heroDesc: "AI productivity, overseas company setup & tax, networking, cross-border e-commerce — we've paved the road with lessons learned. Just walk it.",
        heroBtn1: 'Get Started',
        heroBtn2: "Let's Talk",
        stat1: 'Tools Curated',
        stat2: 'Countries Covered',
        stat3: 'Users Served',
        stat4: 'Satisfaction',
        sectionTitle: 'What can we do for you?',
        sectionDesc: 'Six core areas covering the most critical steps of going global.',
        aiTitle: 'AI Tools & Workflows',
        aiDesc: 'Let AI do the heavy lifting — from content creation to customer outreach, do more with less.',
        taxTitle: 'Overseas Entity & Tax Filing',
        taxDesc: "Company setup, bank accounts, tax compliance — don't let red tape trip you up when you should be sprinting.",
        netTitle: 'Network Technology',
        netDesc: "Reliable networking is your lifeline abroad. Architecture, security, acceleration — you need them all.",
        ecomTitle: 'Cross-border E-commerce',
        ecomDesc: 'Product selection, traffic, fulfillment — find a growth path that actually makes money, no guesswork.',
        web3Title: 'Web3 & Blockchain',
        web3Desc: 'From DeFi to NFTs, wallets to smart contracts — understand the on-chain world and find the right way to go global with Web3.',
        aboutTitle: 'About Us',
        aboutDesc: "A crew that's been at the crossroads of tech, tax, and growth for a while. Solid playbooks, no BS.",
        ctaTitle: 'Ready to go global? 🌊',
        ctaDesc: "Whether you're just starting out or already on the road, let's chat.",
        ctaBtn: 'Contact Us →',
      },
    };

    // ===== 导航栏双语联动 =====
    const navDict = {
      zh: {
        '/ai-tools': 'AI工具及工作流',
        '/global-tax': '海外公司/账户设立报税',
        '/network-tech': '网络技术',
        '/cross-border': '跨境电商',
        '/web3': 'Web3 & 区块链',
        '/about-us': '关于我们',
        '_action': '联系咨询',
      },
      en: {
        '/ai-tools': 'AI Tools',
        '/global-tax': 'Global Setup & Tax',
        '/network-tech': 'Network Tech',
        '/cross-border': 'Cross-border E-com',
        '/web3': 'Web3 & Blockchain',
        '/about-us': 'About Us',
        '_action': 'Contact',
      },
    };

    let current = localStorage.getItem('outgopro-lang') || 'zh';

    const normalizePath = (href) => {
      try { return new URL(href, location.origin).pathname.replace(/\/$/, '') || '/'; }
      catch { return href; }
    };

    // 在 header 右侧注入语言切换按钮
    const injectLangBtn = () => {
      if (document.getElementById('nav-lang-toggle')) return;
      const headerActions = document.querySelector('header .items-center.flex.justify-between');
      if (!headerActions) return;
      const btn = document.createElement('button');
      btn.id = 'nav-lang-toggle';
      btn.className = 'ml-2 px-3 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors';
      btn.type = 'button';
      btn.textContent = current === 'zh' ? '🌐 EN' : '🌐 中文';
      btn.addEventListener('click', () => {
        current = current === 'zh' ? 'en' : 'zh';
        renderAll();
      });
      headerActions.querySelector('.flex')?.appendChild(btn);
    };

    const renderNav = () => {
      document.querySelectorAll('header nav a[href]').forEach((a) => {
        const path = normalizePath(a.getAttribute('href') || '');
        if (navDict[current][path]) a.textContent = navDict[current][path];
      });
      const actionBtns = document.querySelectorAll('header .ml-4 a, header .ml-4 button');
      actionBtns.forEach(b => { if (navDict[current]['_action']) b.textContent = navDict[current]['_action']; });
      const langBtn = document.getElementById('nav-lang-toggle');
      if (langBtn) langBtn.textContent = current === 'zh' ? '🌐 EN' : '🌐 中文';
    };

    const renderPage = () => {
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (key && dict[current]?.[key]) {
          // heroTitle 需要保留 HTML 结构
          if (key === 'heroTitle') {
            const lines = dict[current][key].split(/[，。]/);
            if (current === 'zh') {
              el.innerHTML = '<span class="bg-gradient-to-r from-slate-900 via-blue-800 to-purple-800 dark:from-white dark:via-blue-200 dark:to-purple-200 bg-clip-text text-transparent">别卷了，</span><br/><span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">去赚全世界的钱。</span>';
            } else {
              el.innerHTML = '<span class="bg-gradient-to-r from-slate-900 via-blue-800 to-purple-800 dark:from-white dark:via-blue-200 dark:to-purple-200 bg-clip-text text-transparent">Stop grinding.</span><br/><span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Go make money globally.</span>';
            }
          } else {
            el.textContent = dict[current][key];
          }
        }
      });
      document.documentElement.lang = current === 'zh' ? 'zh-CN' : 'en';
      localStorage.setItem('outgopro-lang', current);
    };

    const renderAll = () => { renderPage(); renderNav(); };

    // 初始化
    injectLangBtn();
    renderAll();

    // 兼容 Astro View Transitions
    document.addEventListener('astro:after-swap', () => { injectLangBtn(); renderAll(); });
  </script>

  <style>
    /* ===== Hero 渐变背景 ===== */
    .hero-gradient {
      background: linear-gradient(135deg, #f0f4ff 0%, #e8ecff 25%, #f5f0ff 50%, #fff 100%);
    }
    :global(.dark) .hero-gradient {
      background: linear-gradient(135deg, #0f172a 0%, #1a1040 40%, #0c1929 100%);
    }

    /* ===== 动态光球 ===== */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.4;
    }
    :global(.dark) .orb { opacity: 0.15; }

    .orb-1 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, #3b82f6, transparent 70%);
      top: -200px; right: -100px;
      animation: float-1 8s ease-in-out infinite;
    }
    .orb-2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, #8b5cf6, transparent 70%);
      bottom: -150px; left: -100px;
      animation: float-2 10s ease-in-out infinite;
    }
    .orb-3 {
      width: 300px; height: 300px;
      background: radial-gradient(circle, #ec4899, transparent 70%);
      top: 50%; left: 40%;
      animation: float-3 12s ease-in-out infinite;
    }

    @keyframes float-1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-40px, 30px) scale(1.1); }
    }
    @keyframes float-2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(30px, -40px) scale(1.05); }
    }
    @keyframes float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-20px, -30px) scale(0.95); }
    }

    /* ===== 网格背景 ===== */
    .grid-bg {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(59,130,246,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.05) 1px, transparent 1px);
      background-size: 60px 60px;
    }
    :global(.dark) .grid-bg {
      background-image:
        linear-gradient(rgba(59,130,246,0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.08) 1px, transparent 1px);
    }

    /* ===== 统计卡片 ===== */
    .stat-card {
      text-align: center;
      padding: 1.5rem 1rem;
      border-radius: 1rem;
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(148,163,184,0.2);
      box-shadow: 0 4px 20px -4px rgba(0,0,0,0.06);
    }
    :global(.dark) .stat-card {
      background: rgba(15,23,42,0.8);
      border-color: rgba(100,116,139,0.3);
      box-shadow: 0 4px 20px -4px rgba(0,0,0,0.3);
    }

    /* ===== 毛玻璃卡片 ===== */
    .card-glass {
      display: block;
      border-radius: 1.25rem;
      padding: 1.75rem;
      background: rgba(255,255,255,0.7);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(148,163,184,0.2);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .card-glass::before {
      content: '';
      position: absolute;
      inset: 0;
